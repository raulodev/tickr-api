# Secret used to sign and verify JWT access tokens.
JWT_SECRET=
# PostgreSQL connection string used by Prisma.
DATABASE_URL=

# Comma-separated allowed CORS origins
CORS_ORIGINS=
# Whether to trust forwarded headers from a reverse proxy
TRUST_PROXY=
# Maximum requests allowed per throttle window
THROTTLE_LIMIT=100
# Throttle window duration in milliseconds
THROTTLE_TTL_MS=60000
