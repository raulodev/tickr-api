# Secret used to sign and verify JWT access tokens.
JWT_SECRET=
# PostgreSQL connection string used by Prisma.
DATABASE_URL=
# Comma-separated allowed CORS origins for browser requests.
CORS_ORIGINS=
# Whether to trust forwarded headers from a reverse proxy.
TRUST_PROXY=
# Maximum requests allowed per throttle window.
THROTTLE_LIMIT=100
# Throttle window duration in milliseconds.
THROTTLE_TTL_MS=60000
# JWT token lifetime (for example: 15m, 1h, 7d).
JWT_EXPIRES_IN=15m
# Sender address used for outgoing emails.
MAIL_FROM="Tickr <delivered@resend.dev>"
# Mail transport backend: "file", "smtp" or "resend".
MAIL_TRANSPORT="resend"
# API key used by the Resend mail transport.
RESEND_API_KEY="re_xxxxx"
# Public base URL of the app, used in auth links and redirect URLs.
APP_URL=http://localhost:3000