generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  MEMBER
}

model Tenant {
  id          String       @id @default(uuid())
  name        String
  slug        String       @unique
  createdAt   DateTime     @default(now())
  memberships Membership[]
  projects    Project[]
}

model User {
  id             String       @id @default(uuid())
  email          String       @unique
  password       String
  name           String?
  createdAt      DateTime     @default(now())
  memberships    Membership[]
  reportedIssues Issue[]      @relation("IssueReporter")
  assignedIssues Issue[]      @relation("IssueAssignee")
}

model Membership {
  id        String   @id @default(uuid())
  userId    String
  tenantId  String
  role      Role     @default(MEMBER)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
  @@index([tenantId])
}

enum IssueStatus {
  OPEN
  IN_PROGRESS
  CLOSED
}

enum IssuePriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Project {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  key       String
  createdAt DateTime @default(now())

  issueCounter Int     @default(0)
  issues       Issue[]

  @@unique([tenantId, key])
  @@unique([tenantId, id])
  @@index([tenantId])
}

model Issue {
  id          String        @id @default(uuid())
  tenantId    String
  projectId   String
  number      Int
  title       String
  description String?
  status      IssueStatus   @default(OPEN)
  priority    IssuePriority @default(MEDIUM)
  reporterId  String
  assigneeId  String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  project  Project @relation(fields: [tenantId, projectId], references: [tenantId, id], onDelete: Cascade)
  reporter User    @relation("IssueReporter", fields: [reporterId], references: [id], onDelete: Restrict)
  assignee User?   @relation("IssueAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@unique([projectId, number])
  @@index([tenantId, projectId, status])
  @@index([assigneeId])
}
